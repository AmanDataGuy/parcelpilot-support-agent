[Unit]
Description=ParcelPilot Streamlit frontend
After=network.target parcelpilot-backend.service
Requires=parcelpilot-backend.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/parcelpilot/frontend
Environment=PARCELPILOT_API_URL=http://localhost:8000
ExecStart=/home/ubuntu/parcelpilot/.venv/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
