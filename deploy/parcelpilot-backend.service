[Unit]
Description=ParcelPilot FastAPI backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/parcelpilot/backend
EnvironmentFile=/home/ubuntu/parcelpilot/.env
ExecStart=/home/ubuntu/parcelpilot/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
